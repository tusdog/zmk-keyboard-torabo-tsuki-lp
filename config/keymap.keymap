/*
 * torabo-tsuki LP L layout (66 positions)
 * Adapted from the attached ergo68 Japanese cheat sheet.
 *
 * Binding order used by the official torabo-tsuki LP L layout:
 * row 0: 6 left + 6 right
 * row 1: 6 left + 6 right
 * row 2: 7 left + 7 right
 * row 3: 7 left + 7 right
 * row 4: 7 left + 7 right
 *
 * Host OS keyboard type must be Japanese/JIS (106/109).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE      0
#define NAV       1
#define SHORTCUT  2
#define MOUSE     3

/* JIS aliases. These are HID positions interpreted by a JIS host layout. */
#define JP_CARET  EQUAL          /* ^ / ~ */
#define JP_AT     LEFT_BRACKET   /* @ / ` */
#define JP_LBKT   RIGHT_BRACKET  /* [ / { */
#define JP_RBKT   NUHS           /* ] / } */
#define JP_COLON  SQT            /* : / * */
#define JP_YEN    INT3           /* ¥ / | */
#define JP_RO     INT1           /* \ / _ (ろ key) */
#define JP_QMARK  FSLH           /* /, Shift = ? */
#define JP_UNDER  LS(INT1)       /* _ */

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base JIS";
            bindings = <
                /* row 0 */
                &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4       &kp N5                 &kp N7 &kp N8       &kp N9     &kp N0       &kp MINUS  &kp JP_CARET
                /* row 1 */
                &kp TAB    &kp Q      &kp W      &kp E      &kp R        &kp T                  &kp Y        &kp U      &kp I        &kp O      &kp P         &kp JP_YEN
                /* row 2 */
                &kp LCTRL  &kp A      &kp S      &kp D      &kp F        &kp G      &kp N6   &kp JP_LBKT  &kp H      &kp J        &kp K      &kp L         &kp SEMI  &kp JP_COLON
                /* row 3 */
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V        &kp B      &kp JP_AT   &kp JP_RBKT  &kp N      &kp M        &kp COMMA  &kp DOT       &kp JP_QMARK  &kp JP_UNDER
                /* row 4 */
                &kp LGUI   &kp LALT   &kp LGUI   &kp BSPC   &mo SHORTCUT  &kp SPACE  &mt LCTRL LANGUAGE_2  &mt LGUI LANGUAGE_1  &mt LSHFT RET  &lt NAV COMMA  &lt MOUSE DOT  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                /* row 0 */
                &trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                &kp F8       &kp F9        &kp F10   &kp F11    &kp F12     &kp BSPC
                /* row 1 */
                &trans  &trans     &kp LC(W)  &trans     &trans     &trans                &msc SCRL_UP  &msc SCRL_RIGHT  &kp UP   &msc SCRL_LEFT  &trans  &trans
                /* row 2 */
                &trans  &kp LC(A)  &kp LC(S)  &trans     &kp LC(F)  &trans  &kp F6        &kp F7       &msc SCRL_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                /* row 3 */
                &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans     &trans       &kp LC(N)      &kp LC(M)  &kp LS(COMMA)  &kp LS(DOT)  &kp LG(UP)  &trans
                /* row 4 */
                &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans       &trans         &trans     &trans       &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        shortcut_layer {
            display-name = "Shortcut";
            bindings = <
                /* row 0: Ctrl + Win/Cmd + number */
                &trans  &kp LC(LG(N1))  &kp LC(LG(N2))  &kp LC(LG(N3))  &kp LC(LG(N4))  &kp LC(LG(N5))    &kp LC(LG(N8))  &kp LC(LG(N9))  &kp LC(LG(N0))  &kp LS(MINUS)  &kp LS(JP_CARET)  &kp BSPC
                /* row 1 */
                &trans  &trans           &kp LG(W)        &msc SCRL_RIGHT  &msc SCRL_LEFT   &msc SCRL_UP       &msc SCRL_UP      &msc SCRL_RIGHT   &kp UP            &msc SCRL_LEFT  &kp LS(N6)        &kp LS(JP_LBKT)
                /* row 2 */
                &trans  &kp LG(A)        &kp LG(S)        &trans           &kp LG(F)        &msc SCRL_DOWN  &trans  &kp JP_LBKT  &msc SCRL_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(JP_COLON)  &kp LS(JP_RBKT)
                /* row 3: 6/7 follow the physical base positions */
                &trans  &kp LG(Z)        &kp LG(X)        &kp LG(C)        &kp LG(V)        &kp LG(B)      &kp LC(LG(N6))  &kp LC(LG(N7))  &kp LG(N)  &kp LG(M)  &kp LS(COMMA)  &kp LS(DOT)  &kp LG(UP)  &kp JP_RO
                /* row 4 */
                &trans  &trans           &trans           &trans           &trans           &trans         &trans            &trans            &trans     &trans     &trans         &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        mouse_layer {
            display-name = "Mouse / BT";
            bindings = <
                /* row 0: Bluetooth recovery controls */
                &out OUT_BLE  &out OUT_USB  &bt BT_SEL 0  &bt BT_NXT  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
                /* row 1 */
                &trans  &trans  &kp LC(UP)  &mmv MOVE_UP    &kp F4          &msc SCRL_UP    &trans  &trans  &trans  &trans  &trans  &trans
                /* row 2 */
                &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans    &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
                /* row 3 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                /* row 4 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
