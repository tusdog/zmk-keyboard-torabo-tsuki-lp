/*
 * torabo-tsuki LP L layout (66 positions)
 * Adapted from the attached ergo68 Japanese cheat sheet.
 *
 * Binding order used by the official torabo-tsuki LP L layout:
 * row 0: 6 left + 6 right
 * row 1: 6 left + 6 right
 * row 2: 7 left + 7 right
 * row 3: 7 left + 7 right
 * row 4: 7 left + 7 right
 *
 * Host OS keyboard type must be Japanese/JIS (106/109).
 */

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE      0
#define NAV       1
#define SHORTCUT  2
#define MOUSE     3
#define SCROLL    4

/* JIS aliases. These are HID positions interpreted by a JIS host layout. */
#define JP_CARET  EQUAL          /* ^ / ~ */
#define JP_AT     LEFT_BRACKET   /* @ / ` */
#define JP_LBKT   RIGHT_BRACKET  /* [ / { */
#define JP_RBKT   NUHS           /* ] / } */
#define JP_COLON  SQT            /* : / * */
#define JP_YEN    INT3           /* ¥ / | */
#define JP_RO     INT1           /* \ / _ (ろ key) */
#define JP_QMARK  FSLH           /* / (Shift: ?) */
#define JP_UNDER  LS(INT1)       /* _ */

/ {
    behaviors {
        /*
         * Generic layer-tap:
         *   hold -> &mo <layer>
         *   tap  -> &kp <key>
         *
         * quick-tap-ms allows tap -> quick second hold to keep the tap-side
         * key held. This is especially useful for Backspace auto-repeat.
         */
        my_lt: my_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Quick Layer-Tap";

            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;

            bindings = <&mo>, <&kp>;
        };

        /*
         * Tap Dance:
         *   single tap -> ,
         *   double tap -> .
         */
        comma_td: comma_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Comma / Dot";

            tapping-term-ms = <200>;

            bindings = <&kp COMMA>, <&kp DOT>;
        };

        /*
         * Tap Dance:
         *   single tap -> /
         *   double tap -> .
         */
        slash_td: slash_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Slash / Dot";

            tapping-term-ms = <200>;

            bindings = <&kp JP_QMARK>, <&kp DOT>;
        };
    };

    /*
     * Zero-parameter wrappers around mouse scrolling.
     * These can be exposed as user-defined behaviors in ZMK Studio.
     */
    macros {
        scroll_up: scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Up";
            wait-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_UP>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_UP>;
        };

        scroll_down: scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Down";
            wait-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_DOWN>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_DOWN>;
        };

        scroll_left: scroll_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Left";
            wait-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_LEFT>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_LEFT>;
        };

        scroll_right: scroll_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Scroll Right";
            wait-ms = <0>;

            bindings =
                <&macro_press &msc SCRL_RIGHT>,
                <&macro_pause_for_release>,
                <&macro_release &msc SCRL_RIGHT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base JIS";
            bindings = <
                /* row 0 */
                &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4       &kp N5
                &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS    &mt BSPC JP_CARET

                /* row 1 */
                &kp TAB    &kp Q      &kp W      &kp E      &kp R        &kp T
                &kp Y      &kp U      &kp I      &kp O      &kp P        &kp JP_YEN

                /*
                 * row 2
                 *
                 * F:
                 *   tap  -> F
                 *   hold -> Scroll mode
                 */
                &kp LCTRL  &kp A      &kp S      &kp D      &lt SCROLL F &kp G      &kp N6
                &kp JP_LBKT  &kp H    &kp J      &kp K      &kp L        &kp SEMI   &kp JP_COLON

                /*
                 * row 3
                 *
                 * Right hand:
                 * ]  N  M  ,  /  ↑  _
                 *
                 * /:
                 *   single tap -> /
                 *   double tap -> .
                 */
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V        &kp B      &kp JP_AT
                &kp JP_RBKT  &kp N    &kp M      &comma_td   &slash_td    &kp UP      &kp JP_UNDER

                /*
                 * row 4
                 *
                 * LANGUAGE_2:
                 *   tap  -> LANGUAGE_2
                 *   hold -> Mouse / BT
                 */
                &kp LGUI   &kp LALT   &kp LGUI   &kp JP_AT
                &my_lt MOUSE BSPC
                &my_lt SHORTCUT SPACE
                &lt MOUSE LANGUAGE_2

                &mt LGUI LANGUAGE_1
                &mt LSHFT RET
                &lt NAV COMMA
                &lt MOUSE DOT
                &kp LEFT
                &kp DOWN
                &kp RIGHT
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                /* row 0 */
                &trans  &kp F1     &kp F2     &kp F3     &kp F4     &kp F5
                &kp F8  &kp F9     &kp F10    &kp F11    &kp F12    &kp BSPC

                /* row 1 */
                &trans  &trans     &kp LC(W)  &trans     &trans     &trans
                &msc SCRL_UP  &msc SCRL_RIGHT  &kp UP  &msc SCRL_LEFT  &trans  &trans

                /*
                 * row 2
                 *
                 * physical F:
                 *   tap  -> Ctrl+F
                 *   hold -> Scroll mode
                 */
                &trans  &kp LC(A)  &kp LC(S)  &trans     &lt SCROLL LC(F)  &trans  &kp F6
                &kp F7  &msc SCRL_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans

                /* row 3 */
                &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans
                &trans  &kp LC(N)  &kp LC(M)  &kp LS(COMMA)  &kp LS(DOT)  &kp LG(UP)  &trans

                /* row 4 */
                &trans  &trans     &trans     &trans     &trans     &trans     &trans
                &trans  &trans     &trans     &trans     &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        shortcut_layer {
            display-name = "Shortcut";
            bindings = <
                /* row 0: Ctrl + Win/Cmd + number */
                &trans  &kp LC(LG(N1))  &kp LC(LG(N2))  &kp LC(LG(N3))  &kp LC(LG(N4))  &kp LC(LG(N5))
                &kp LC(LG(N8))  &kp LC(LG(N9))  &kp LC(LG(N0))  &kp LS(MINUS)  &kp LS(JP_CARET)  &kp BSPC

                /* row 1 */
                &trans  &trans  &kp LG(W)  &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc SCRL_UP
                &msc SCRL_UP  &msc SCRL_RIGHT  &kp UP  &msc SCRL_LEFT  &kp LG(P)  &kp LS(JP_LBKT)

                /*
                 * row 2
                 *
                 * physical F:
                 *   tap  -> GUI+F
                 *   hold -> Scroll mode
                 */
                &trans  &kp LG(A)  &kp LG(S)  &trans  &lt SCROLL LG(F)  &msc SCRL_DOWN  &trans
                &kp JP_LBKT  &msc SCRL_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(JP_COLON)  &kp LS(JP_RBKT)

                /* row 3 */
                &trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &kp LC(LG(N6))
                &kp LC(LG(N7))  &kp LG(N)  &kp LG(M)  &kp LS(COMMA)  &kp LS(DOT)  &kp LG(UP)  &kp JP_RO

                /* row 4 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        /*
         * Mouse / BT
         *
         * Y = Show All Applications
         * U = Ctrl + Left
         * I = Ctrl + Right
         * O = Show All Windows
         *
         * 6 = BT 0
         * . = BT 1
         * [ = BT 2
         * ] = BT 3
         *
         * H = Scroll Up
         * N = Scroll Down
         * M = Scroll Left
         * , = Scroll Right
         *
         * J = Left Click
         * K = Right Click
         * L = Back
         * ; = Forward
         */
        mouse_layer {
            display-name = "Mouse / BT";
            bindings = <
                /* row 0 */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &kp BSPC

                /* row 1 */
                &trans  &trans  &trans  &trans  &trans  &trans

                &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS
                &kp LC(LEFT)
                &kp LC(RIGHT)
                &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS
                &trans
                &trans

                /*
                 * row 2
                 *
                 * 6 = BT 0
                 *
                 * [ = BT 2
                 * H = Scroll Up
                 * J = MB1 / Left Click
                 * K = MB2 / Right Click
                 * L = MB4 / Back
                 * ; = MB5 / Forward
                 */
                &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0

                &bt BT_SEL 2
                &scroll_up
                &mkp MB1
                &mkp MB2
                &mkp MB4
                &mkp MB5
                &trans

                /*
                 * row 3
                 *
                 * . = BT 1
                 *
                 * ] = BT 3
                 * N = Scroll Down
                 * M = Scroll Left
                 * , = Scroll Right
                 */
                &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 1

                &bt BT_SEL 3
                &scroll_down
                &scroll_left
                &scroll_right
                &trans
                &kp UP
                &trans

                /* row 4 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans

                &trans
                &trans
                &trans
                &trans
                &kp LEFT
                &kp DOWN
                &kp RIGHT
            >;
        };

        /*
         * Scroll layer
         *
         * Fを長押ししている間だけ有効。
         * 全キーtransparentなので、下にある通常レイヤーは維持される。
         */
        scroll_layer {
            display-name = "Scroll";
            bindings = <
                /* row 0 */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans

                /* row 1 */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans

                /* row 2 */
                &kp LG(MINUS)  &kp LG(N0)  &kp LG(LS(SEMI))  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans

                /* row 3 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans

                /* row 4 */
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

/*
 * 通常時:
 *   Trackball X/Y -> Cursor
 *
 * F長押し中:
 *   Trackball X/Y -> Scroll
 *
 * スクロール量:
 *   1/6
 */
&pointing_listener {
    scroll_mode {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 12>;
    };
};
